# ── CORE SERVER & PERSISTENT VOLUME ──────────────────────────
PORT=3000
NODE_ENV=production
RAILWAY_VOLUME_MOUNT_PATH=/app/data
DB_TYPE=sqlite
SQLITE_PATH=/app/data/urooj_suite.db

# ── AI STUDIO FRONTEND <-> RAILWAY BACKEND BRIDGE ────────────
# Set RAILWAY_BACKEND_URL to your public Railway https://xxxx.up.railway.app URL
RAILWAY_BACKEND_URL=
PERMANENT_AUTH_SECRET=urooj-master-permanent-secret-254141693915
AUTO_REAUTH_ENABLED=true
CORS_ORIGIN=*
KEEP_ALIVE_INTERVAL_MS=45000

# ── BOT IDENTITY & OWNER CONFIGURATION ───────────────────────
BOT_NAME=Urooj Choudhary
BOT_OWNER=Urooj Choudhary
OWNER_NUMBER=254141693915
PREFIX=.
COMMAND_MODE=public
TIMEZONE=Asia/Karachi
SESSION_ID=

# ── WHATSAPP AUTOMATION TOGGLES ──────────────────────────────
AUTOREAD=false
AUTOTYPE=false
AUTORECORD=false
AUTORECORDTYPE=false
AUTO_STATUS_REACT=true
AUTO_STATUS_REPLY=false
AUTO_STATUS_MSG=Status Viewed by Urooj Choudhary
ALWAYSONLINE=true
BUTTONMODE=on
PACK_AUTHOR=Urooj Choudhary
PACK_NAME=Urooj Choudhary

# ── HAYA AI CHAT PERSONA & GEMINI ENGINE ─────────────────────
GEMINI_API_KEY=
HAYA_AI_ENABLED=true
HAYA_AI_MODEL=gemini-3.8-flash
HAYA_TRANSCRIBE_MODEL=gemini-3.5-transcribe
HAYA_TTS_MODEL=gemini-3.8-flash-lite-tts
HAYA_TIMEZONE=Asia/Karachi
HAYA_DEFAULT_SCOPE=dm
HAYA_BUSY_MIN_MINUTES=10
HAYA_BUSY_MAX_MINUTES=15
HAYA_GOOD_NIGHT_WINDOW_START=20:56
HAYA_GOOD_NIGHT_WINDOW_END=20:58
HAYA_SLEEP_START=21:00
HAYA_SLEEP_END=05:00
HAYA_MORNING_DISPATCH_START=05:10
HAYA_MORNING_DISPATCH_END=05:12
HAYA_RETENTION_DAYS=30

# ── OPTIONAL EXTERNAL SERVICES ───────────────────────────────
DATABASE_URL=
GIPHY_API_KEY=
MONGO_URI=
REDIS_URL=
SUPABASE_DB_URL=